# Copiare in .env e valorizzare. Non committare mai .env (vedi .gitignore).

# Stringa di connessione PostgreSQL. In sviluppo locale (host "localhost"
# o "127.0.0.1") la connessione non usa SSL; verso Neon (o un altro host
# remoto) SSL è richiesto automaticamente (vedi server/db.js).
DATABASE_URL=postgres://utente:password@localhost:5432/osservazioni_pedagogiche

# Porta HTTP del server applicativo.
PORT=3000

# Segreto usato per derivare il token CSRF da ogni sessione
# (HMAC-SHA256(SESSION_SECRET, sessionId)). Deve essere lungo e casuale:
# generarne uno con, ad esempio, `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Cambiarlo invalida tutti i token CSRF in circolazione (non le sessioni).
SESSION_SECRET=sostituire-con-un-valore-casuale-lungo-almeno-32-byte

# Timeout della sessione (sez. 11 dell'architettura).
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# Flag Secure del cookie di sessione. Deve restare "true" ovunque tranne
# che in sviluppo locale senza TLS (http://localhost), dove il browser
# scarterebbe un cookie Secure su una connessione non cifrata.
COOKIE_SECURE=true
